// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Recipe {
  id           Int      @id @default(autoincrement())
  name         String
  ingredients  String[]
  instructions String[]
  country      String
  description  String
  createdAt    DateTime @default(now())
  img          String   @default("https://generated.vusercontent.net/placeholder.svg")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String?  @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String?
  createdAt    DateTime @default(now())
}

model Country {
  id          Int    @id @default(autoincrement())
  country     String
  description String
}

model Review {
  id          Int    @id @default(autoincrement())
  author      String @default("Anonimus")
  description String
  recipeId    Int
  owner       String
}
